@*
    Embedly.razor
    ==============
    Demonstrates Syncfusion Blazor Rich Text Editor with Embedly integration.
    
    Features:
    - Rich text editor for content creation with minimal toolbar
    - Automatic transformation of links into rich preview cards
    - Embedly-powered previews with titles, descriptions, and images
    - Support for multiple content types (videos, articles, images, documents)
    - Real-time link processing and preview rendering
    
    Key Functionality:
    - CreateLink button: Insert URLs into the editor
    - OnActionComplete event: Triggers when links are added
    - JavaScript interop: Bridges Blazor and Embedly library
    - OnAfterRenderAsync: Initializes Embedly on component load
*@

@page "/"

@using Syncfusion.Blazor.RichTextEditor
 
@inject IJSRuntime JS

<PageTitle>Embedly Integration - Rich Text Editor</PageTitle>

<div class="control-section">
    <div class="content-wrapper">
        <h3>Rich Text Editor with Embedly Integration</h3>
        <p class="mb-3">
            Click the <strong>link icon</strong> in the toolbar to insert a URL.
            The link will automatically transform into a rich preview card
            with title, description, and thumbnail image powered by Embedly.
        </p>
        <SfRichTextEditor @ref="Editor" Placeholder="Click link icon to add URLs">
            <RichTextEditorToolbarSettings Items="@ToolbarItems"></RichTextEditorToolbarSettings>
            <RichTextEditorEvents OnActionComplete="@OnActionComplete"></RichTextEditorEvents>
            <RichTextEditorQuickToolbarSettings />
            <RichTextEditorContent>
                <p>
                    <strong>
                        Embedly integration automatically transforms plain links into rich, 
                        interactive preview cards with titles, descriptions, and thumbnails.
                    </strong>
                </p>
                <h4>How it works:</h4>
                <ul>
                    <li>
                        <strong>Paste or create links</strong> - 
                        Use the CreateLink toolbar button to add URLs to the editor
                    </li>
                    <li>
                        <strong>Automatic card rendering</strong> - 
                        Links are automatically converted to rich Embedly cards with preview, 
                        title, and description
                    </li>
                    <li>
                        <strong>Supported content</strong> - 
                        Works with articles, videos, images, documents, and other embeddable 
                        web content
                    </li>
                </ul>
            </RichTextEditorContent>
        </SfRichTextEditor>
    </div>
</div>

@code {
    /// <summary>
    /// Reference to the Syncfusion Rich Text Editor component instance
    /// Used to access editor properties and methods programmatically
    /// </summary>
    private SfRichTextEditor Editor;
 
    /// <summary>
    /// Toolbar items configuration for the Rich Text Editor
    /// Contains only the CreateLink button to keep interface simple and focused
    /// Users can click this button to insert URLs which will be converted to Embedly cards
    /// </summary>
    private List<ToolbarItemModel> ToolbarItems = new()
    {
        new ToolbarItemModel { Command = ToolbarCommand.CreateLink }
    };
 
    /// <summary>
    /// Event handler called when toolbar action completes
    /// Specifically handles when user inserts or modifies a link
    /// </summary>
    private async Task OnActionComplete(ActionCompleteEventArgs args)
    {
        // Check if the action was a link insertion
        if (args.RequestType == "Links")
        {
            // Call JavaScript interop function to wrap link in Embedly card
            await JS.InvokeVoidAsync("embedlyInterop.wrapLinkInEmbedlyCard");
        }
    }
 
    /// <summary>
    /// Lifecycle method called after component renders to the DOM
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Call JavaScript function to initialize Embedly library
            await JS.InvokeVoidAsync("initializeEmbedly");
        }
    }
}
